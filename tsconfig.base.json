{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@linuxoffice/shared/*": ["apps/shared/src/*"],
      "@linuxoffice/main/*": ["apps/main/src/*"],
      "@linuxoffice/renderer/*": ["apps/renderer/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo"]
}